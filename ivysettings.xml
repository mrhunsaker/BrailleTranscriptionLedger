<?xml version="1.0" encoding="UTF-8"?>
<ivysettings>
  <!-- Simple ivysettings using Maven Central as the default resolver -->
  <settings defaultResolver="central"/>
  <resolvers>
    <!-- Use maven central (Maven2 layout) -->
    <ibiblio name="central" m2compatible="true" root="https://repo1.maven.org/maven2/"/>
  </resolvers>

  <!-- Optional: use the local Ivy cache (default) -->
</ivysettings>
