<?xml version="1.0" encoding="UTF-8"?>
<project name="BrailleTranscriptionLedger" default="run" basedir="."
    xmlns:ivy="antlib:org.apache.ivy.ant">

    <!-- Set global properties -->
    <property name="src.dir" value="src/main/java"/>
    <property name="build.dir" value="build"/>
    <property name="dist.dir" value="dist"/>
    <property name="main-class" value="BrailleTranscriptionLedger.LedgerGUI"/>
    <property name="lib.dir" value="lib"/>
    <!-- Path to a local Ivy jar if offline; resolve target will populate lib/ via Ivy retrieve -->
    <property name="ivy.jar" value="lib/ivy-2.5.1.jar"/>

    <!-- Ensure Ivy runtime is available locally (downloads Ivy jar if not present) -->
    <target name="ensure-ivy">
        <mkdir dir="${lib.dir}"/>
        <!-- If ivy.jar is missing, download it from Maven Central -->
        <condition property="ivy.exists">
            <available file="${ivy.jar}"/>
        </condition>
        <get src="https://repo1.maven.org/maven2/org/apache/ivy/ivy/2.5.1/ivy-2.5.1.jar" dest="${ivy.jar}" skipexisting="true"/>
    </target>

    <!-- Ivy settings: define the Ivy Ant tasks after ensuring the ivy jar is present -->
    <target name="ivy-init" depends="ensure-ivy">
        <taskdef uri="antlib:org.apache.ivy.ant" resource="org/apache/ivy/ant/antlib.xml" classpath="${ivy.jar}"/>
        <ivy:settings file="ivysettings.xml"/>
    </target>

    <!-- Resolve dependencies and retrieve them to lib/ -->
    <target name="resolve" depends="ivy-init">
        <ivy:resolve/>
        <!-- Retrieve jars into lib/ using a predictable naming pattern -->
        <ivy:retrieve pattern="${lib.dir}/[organisation]/[module]-[artifact]-[revision].[ext]"/>
    </target>

    <!-- Create build and dist directories -->
    <target name="init">
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${dist.dir}"/>
        <mkdir dir="${lib.dir}"/>
    </target>

    <!-- Copy resources -->
    <target name="copy-resources">
        <copy todir="${build.dir}">
            <fileset dir="src/main/resources"/>
        </copy>
    </target>

    <!-- Compile source files -->
    <target name="compile" depends="init,resolve,copy-resources">
        <javac srcdir="${src.dir}" destdir="${build.dir}" includeantruntime="false">
            <classpath>
                <fileset dir="${lib.dir}">
                    <include name="**/*.jar"/>
                </fileset>
            </classpath>
        </javac>
    </target>

    <!-- Create JAR file with dynamic manifest classpath -->
    <target name="jar" depends="compile">
        <path id="jar.classpath">
            <fileset dir="${lib.dir}">
                <include name="**/*.jar"/>
            </fileset>
        </path>
        <manifestclasspath property="manifest.classpath" jarfile="${dist.dir}/BrailleTranscriptionLedger.jar">
            <classpath refid="jar.classpath"/>
        </manifestclasspath>
        <jar destfile="${dist.dir}/BrailleTranscriptionLedger.jar" basedir="${build.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main-class}"/>
                <attribute name="Class-Path" value="${manifest.classpath}"/>
            </manifest>
        </jar>
    </target>

    <!-- Assemble (alias for jar) -->
    <target name="assemble" depends="jar"/>

    <!-- Run the application -->
    <!-- Run the application using the created dist JAR and lib classpath -->
    <target name="run" depends="assemble">
        <java classname="${main-class}" fork="true">
            <classpath>
                <pathelement location="${dist.dir}/BrailleTranscriptionLedger.jar"/>
                <fileset dir="${lib.dir}">
                    <include name="**/*.jar"/>
                </fileset>
            </classpath>
        </java>
    </target>

    <!-- Clean build, dist, and lib directories -->
    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
        <!-- Uncomment the next line if you want to clean downloaded jars -->
        <!-- <delete dir="${lib.dir}"/> -->
    </target>

</project>
